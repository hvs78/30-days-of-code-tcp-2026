class Solution {
public:
    int longestConsecutive(vector<int>& nums) {
        sort(nums.begin(),nums.end());
        int m=0;
        int  c=0;
        for(int i=1;i<nums.size();i++)
        {
            if(nums[i]==(nums[i-1]+1))
            {
                c++;
                m=max(c,m);
            }
            else if(nums[i]==nums[i-1])
            continue;
            else{
                c=0;
            }
        }
        if(nums.size()>0)
        return m+1;
        return 0;
    }
};